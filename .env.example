# Copie este arquivo para .env e preencha com os valores do seu ambiente.
# Nunca envie o arquivo .env para o GitHub.

PORT=3000
NODE_ENV=development

# Banco local (docker compose) ou Amazon RDS em produção
DATABASE_URL=postgres://vaca:vaca@localhost:5432/vaca_amarela

# Use true em produção (RDS exige conexão SSL)
DATABASE_SSL=false

# Segredo da sessão (login)
SESSION_SECRET=troque-por-um-valor-aleatorio

# Banco usado pelos testes automatizados (npm test) – é apagado e recriado a cada execução
TEST_DATABASE_URL=postgres://vaca:vaca@localhost:5432/vaca_amarela_teste
