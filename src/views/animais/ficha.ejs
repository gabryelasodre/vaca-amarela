<%- include('../partials/topo') %>
<a class="voltar" href="/animais">← Animais</a>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
  <h1 class="titulo-pagina mb-0">Nº <%= animal.numero %><%= animal.nome ? ' · ' + animal.nome : '' %></h1>
  <% if (animal.situacao !== 'ativo') { %><span class="etiqueta-inativo"><%= animal.situacao %></span><% } %>
</div>

<div class="grade-cartoes mt-3">
  <section class="cartao">
    <h2>Dados</h2>
    <dl class="dados">
      <dt>Categoria</dt><dd class="text-capitalize"><%= animal.categoria %></dd>
      <dt>Sexo</dt><dd><%= animal.sexo === 'F' ? 'Fêmea' : 'Macho' %></dd>
      <dt>Lote</dt><dd><%= animal.lote || 'Sem lote' %></dd>
      <dt>Raça</dt><dd><%= animal.raca || '—' %></dd>
      <dt>Nascimento</dt><dd><%= animal.data_nascimento ? animal.data_nascimento.split('-').reverse().join('/') + (animal.nascimento_estimado ? ' (estimada)' : '') : '—' %></dd>
      <dt>Mãe</dt><dd><%= animal.mae_numero ? 'Nº ' + animal.mae_numero + (animal.mae_nome ? ' · ' + animal.mae_nome : '') : '—' %></dd>
      <dt>Brinco</dt><dd><%= animal.brinco || '—' %></dd>
      <dt>Sinais</dt><dd><%= animal.sinais || '—' %></dd>
    </dl>
  </section>
  <section class="cartao">
    <h2>Histórico de lotes</h2>
    <% if (historico.length === 0) { %><p class="vazio">Sem movimentações.</p><% } else { %>
      <ul class="lista-categorias">
        <% historico.forEach(function (h) { %>
          <li><span><%= h.origem ? h.origem + ' → ' : 'Entrada em ' %><strong><%= h.destino %></strong></span><span><%= h.data.split('-').reverse().join('/') %></span></li>
        <% }) %>
      </ul>
    <% } %>
    <h2 class="mt-3">Pesagens e manejos</h2>
    <p class="vazio">Disponíveis a partir da Sprint 03 (RF04 e RF05).</p>
  </section>
</div>

<div class="acoes-rapidas">
  <a class="btn btn-acao" href="/animais/<%= animal.id %>/editar">Editar</a>
  <% if (animal.situacao === 'ativo') { %>
    <form method="post" action="/animais/<%= animal.id %>/inativar"><button class="btn btn-acao secundario w-100" type="submit">Inativar</button></form>
  <% } else { %>
    <form method="post" action="/animais/<%= animal.id %>/reativar"><button class="btn btn-acao secundario w-100" type="submit">Reativar</button></form>
  <% } %>
</div>
<%- include('../partials/rodape') %>
