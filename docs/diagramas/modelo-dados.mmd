  PROPRIEDADE ||--o{ USUARIO : possui
  PROPRIEDADE ||--o{ LOTE : organiza
  PROPRIEDADE ||--o{ ANIMAL : possui
  LOTE ||--o{ ANIMAL : "lote atual"
  ANIMAL ||--o{ MOVIMENTACAO_LOTE : "histórico de lotes"
  LOTE ||--o{ MOVIMENTACAO_LOTE : destino
  ANIMAL ||--o{ PESAGEM : tem
  LOTE ||--o{ MANEJO_COLETIVO : recebe
  MANEJO_COLETIVO ||--o{ MANEJO : "gera um por animal"
  ANIMAL ||--o{ MANEJO : recebe
  ANIMAL ||--o{ EVENTO_REPRODUTIVO : tem
  ANIMAL |o--o{ ANIMAL : "mãe de"
